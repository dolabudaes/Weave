AI_API_KEY=
AI_TEXT_MODEL=
AI_VISION_MODEL=
AI_EMBEDDING_MODEL=
VITE_API_URL=http://localhost:8000
DEV_ADMIN_PASSWORD=weave12345
DEV_DEMO_SOURCE_USER=user1
DEV_DEMO_PEER_USER=user2
SEED_DEMO_CONNECTION=1
